---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const { title, description = "CU4TRO20 Pizza & Cafe" } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
